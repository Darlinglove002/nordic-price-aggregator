# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# Telegram: create a bot with @BotFather. Leave empty to run the scheduler without a bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Empty = the bot answers nobody.
# Not sure of your id? Start the bot once: a denied chat is told its own id.
ALLOWED_CHAT_IDS=

# Scheduling: a cron expression wins over the interval.
SYNC_INTERVAL_MINUTES=60
# SYNC_CRON=0 */6 * * *

# Scraping / reporting
SCRAPE_CONCURRENCY=10
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=3
ENABLE_BOOKS_SOURCE=true
FX_REFRESH=true
MIN_DROP_PERCENT=1.0

# Only used by docker compose
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5442
