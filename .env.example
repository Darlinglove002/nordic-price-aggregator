# Copy to .env and fill in. .env is git-ignored; never commit real tokens.

# Telegram: create a bot with @BotFather. Leave empty to run the scheduler without a bot.
TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids allowed to use the bot. Empty = the bot answers nobody.
# Not sure of your id? Start the bot once: a denied chat is told its own id.
ALLOWED_CHAT_IDS=

# Scheduling: a cron expression wins over the interval.
SYNC_INTERVAL_MINUTES=60
# SYNC_CRON=0 */6 * * *

# Scraping / reporting
SCRAPE_CONCURRENCY=10
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRIES=3
ENABLE_BOOKS_SOURCE=true
# Where the bundled mock shops listen (docker compose overrides it for the app container).
MOCK_SHOP_URL=http://localhost:8099
FX_REFRESH=true
MIN_DROP_PERCENT=1.0
# How many changes the digest lists per section.
REPORT_MAX_ITEMS=15

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Running the app outside Docker? Point it at the compose database (published on DB_HOST_PORT).
# Inside docker compose this is set for you.
# DATABASE_URL=postgresql+asyncpg://prices:change-me@localhost:5442/prices

# Only used by docker compose
POSTGRES_PASSWORD=change-me
DB_HOST_PORT=5442
# Mock shop behaviour: simulated latency per request, share of random 503s, and the price epoch.
MOCK_LATENCY_MS=250
MOCK_FAIL_RATE=0.03
MOCK_EPOCH_SECONDS=0
